# Super Admin inicial (não use aspas)
PLATFORM_ADMIN_EMAIL=admin@seudominio.com

# Supabase Auth. A chave publishable pode aparecer no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Postgres. Copie a URL do Session pooler (IPv4), mas mantenha
# literalmente [YOUR-PASSWORD]. A aplicação codifica a senha automaticamente.
# Nunca prefixe estas variáveis com NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:[YOUR-PASSWORD]@HOST_POOLER:5432/postgres
DATABASE_PASSWORD=SUA_SENHA_REAL_DO_BANCO
DATABASE_POOL_SIZE=5

# Bucket privado criado pelo arquivo supabase/schema.sql
SUPABASE_STORAGE_BUCKET=mapa-operacional-private

# SERVICE_ROLE não é necessária: uploads usam a sessão e as políticas RLS do usuário.

# Asaas: comece em sandbox e troque para production somente após os testes.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=

# Token próprio de 32 a 255 caracteres; não reutilize a API Key do Asaas.
ASAAS_WEBHOOK_TOKEN=
