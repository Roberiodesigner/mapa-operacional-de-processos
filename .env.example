# Super Admin inicial (não use aspas)
PLATFORM_ADMIN_EMAIL=admin@seudominio.com

# Autenticação por e-mail. Use um projeto exclusivo do Mapa Operacional.
# A chave publishable pode ser exposta ao navegador; nunca use a secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Asaas: comece em sandbox e troque para production somente após os testes
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=

# Token próprio de 32 a 255 caracteres; não reutilize a API Key do Asaas
ASAAS_WEBHOOK_TOKEN=
